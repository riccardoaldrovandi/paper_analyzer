# Ambiente virtuale Python
venv/
env/
ENV/
.venv/

# Variabili d'ambiente e chiavi API
.env

# Cache di Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# File di dati esportati dalle ricerche (JSON e CSV generati dinamicamente)
*.json
*.csv

# Cartelle dei download locali (PDF e sorgenti LaTeX)
downloaded_pdfs/
downloaded_latex/

# Figure estratte e run di PySR (rigenerabili, non vanno versionati)
extracted_images/
outputs/

# Dataset di fine-tuning generato (grande, rigenerabile via export-dataset)
*.jsonl

# Cache di Unsloth: finisce qui solo se uno script di training viene lanciato
# per sbaglio da questa cartella invece che dal repo separato di fine-tuning
unsloth_compiled_cache/

# IDE e configurazioni di sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
