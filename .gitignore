# Python virtual environment
venv/
env/
ENV/
.venv/

# Environment variables and API keys
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Data files exported by searches (dynamically generated JSON and CSV)
*.json
*.csv

# Local download folders (PDFs and LaTeX sources)
downloaded_pdfs/
downloaded_latex/

# Extracted figures and PySR runs (regenerable, not to be versioned)
extracted_images/
outputs/

# Generated fine-tuning dataset (large, regenerable via export-dataset)
*.jsonl

# full-analyze/export-dataset resume checkpoints (temporary state,
# deleted automatically at the end of a successful run)
full_analyze_checkpoints/

# Unsloth cache: only ends up here if a training script is launched from
# this folder by mistake instead of from the separate fine-tuning repo
unsloth_compiled_cache/

# IDE and system settings
.vscode/
.idea/
.DS_Store
Thumbs.db
